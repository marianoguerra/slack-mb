// Generates slack/methods/generated_methods.mbt from
// ext/metadata/rate_limit_tiers.json.
//
// In MoonBit rather than a shell or Python script for two reasons: CI then
// needs no second toolchain, and the generator exercises the same JSON handling
// the library ships. Run it through ext/scripts/gen.sh, which redirects stdout
// and reformats; `gen.sh --check` fails CI when the checked-in file has drifted.

///|
/// Where the tier metadata lives, relative to the repo root and to ext/.
///
/// Two candidates because `moon run` resolves relative paths against the
/// directory it was invoked from, and this is invoked from both.
let metadata_candidates : Array[String] = [
  "ext/metadata/rate_limit_tiers.json", "metadata/rate_limit_tiers.json",
]

///|
fn read_metadata() -> String raise {
  for path in metadata_candidates {
    if @fs.path_exists(path) {
      return @fs.read_file_to_string(path)
    }
  }
  fail(
    "could not find rate_limit_tiers.json; looked for \{metadata_candidates.join(", ")} relative to \{"the current directory"}",
  )
}

///|
/// `chat.postMessage` -> `chat_post_message`.
///
/// Dots become underscores and camelCase becomes snake_case, which is the
/// spelling a MoonBit caller expects.
///
/// A run of capitals stays one word, except that its LAST letter starts the
/// next word when a lowercase letter follows -- so `getUploadURLExternal` is
/// `get_upload_url_external` and not `get_upload_urlexternal`, while
/// `revokePublicURL` (an acronym at the end, with nothing after it) stays
/// `revoke_public_url`. A digit does not start a new word, so `oauth.v2.access`
/// is `oauth_v2_access`.
fn to_snake_case(name : String) -> String {
  let out = StringBuilder::new()
  for i in 0..<name.length() {
    let c = name[i].to_int()
    if c == '.'.to_int() {
      out.write_char('_')
    } else if is_upper(c) {
      let prev = if i > 0 { name[i - 1].to_int() } else { -1 }
      let next = if i + 1 < name.length() { name[i + 1].to_int() } else { -1 }
      let boundary = is_lower(prev) ||
        is_digit(prev) ||
        (is_upper(prev) && is_lower(next))
      if boundary {
        out.write_char('_')
      }
      out.write_char((c - 'A'.to_int() + 'a'.to_int()).unsafe_to_char())
    } else {
      out.write_char(c.unsafe_to_char())
    }
  }
  out.to_string()
}

///|
fn is_upper(c : Int) -> Bool {
  c >= 'A'.to_int() && c <= 'Z'.to_int()
}

///|
fn is_lower(c : Int) -> Bool {
  c >= 'a'.to_int() && c <= 'z'.to_int()
}

///|
fn is_digit(c : Int) -> Bool {
  c >= '0'.to_int() && c <= '9'.to_int()
}

///|
fn main {
  let generated = generate() catch {
    e => {
      println("gen_methods failed: \{e}")
      panic()
    }
  }
  println(generated)
}

///|
fn generate() -> String raise {
  let text = read_metadata()
  let json = @json.parse(text)
  guard json is Object(entries) else {
    fail("rate_limit_tiers.json is not a JSON object")
  }

  // Sorted, so the generated file is a function of the metadata and not of the
  // JSON parser's iteration order -- otherwise the drift check would fire at
  // random.
  let names = []
  for name, _ in entries {
    names.push(name)
  }
  // `lexical_compare`, not `sort()`: MoonBit's `Compare` for String is shortlex
  // (shorter strings first), which would group the generated file by name
  // length -- readable to nobody and needlessly unstable when a short method
  // name is added.
  names.sort_by((a, b) => a.lexical_compare(b))
  let seen : Map[String, String] = Map([])
  let out = StringBuilder::new()
  out.write_string(
    (
      #|// Generated by ext/tools/gen_methods from ext/metadata/rate_limit_tiers.json.
      #|// DO NOT EDIT. Run `just gen` to regenerate; CI fails when this drifts.
      #|//
      #|// One constant per Slack Web API method, plus the tier table behind
      #|// `tier_of`. The constants exist so a typo in a method name is a compile
      #|// error rather than an `unknown_method` at runtime; the generic
      #|// `Client::call` still accepts any string, for methods newer than this file.
      #|
    ),
  )
  out.write_string("\n")
  for name in names {
    let ident = to_snake_case(name)
    match seen.get(ident) {
      Some(other) =>
        // Two method names mangling to one identifier would silently drop a
        // constant. Fail the generator instead: it is a five-minute fix here
        // and a mystery in the compiler otherwise.
        fail(
          "identifier collision: '\{name}' and '\{other}' both mangle to '\{ident}'",
        )
      None => seen[ident] = name
    }
    out.write_string("///|\n")
    out.write_string("pub let \{ident} : String = \{escape(name)}\n\n")
  }
  out.write_string("///|\n")
  out.write_string(
    "/// Every method name in Slack's rate-limit metadata, sorted.\n",
  )
  out.write_string("pub let method_names : Array[String] = [\n")
  for name in names {
    out.write_string("  \{escape(name)},\n")
  }
  out.write_string("]\n\n")
  out.write_string("///|\n")
  out.write_string("/// The tier table behind `tier_of`.\n")
  out.write_string("let method_tiers : Map[String, RateLimitTier] = {\n")
  for name in names {
    guard entries.get(name) is Some(String(tier)) else {
      fail("tier for '\{name}' is not a string")
    }
    out.write_string("  \{escape(name)}: \{tier_constructor(tier)},\n")
  }
  out.write_string("}\n")
  out.to_string()
}

///|
/// The metadata's tier names, mapped to this library's constructors. Kept in
/// step with `RateLimitTier::parse` -- the coverage test would catch a drift,
/// but a missing case here fails the generator first, which is earlier.
fn tier_constructor(metadata_name : String) -> String raise {
  match metadata_name {
    "Tier1" => "Tier1"
    "Tier2" => "Tier2"
    "Tier3" => "Tier3"
    "Tier4" => "Tier4"
    "SpecialTier_auth_test" => "SpecialAuthTest"
    "SpecialTier_chat_getPermalink" => "SpecialChatGetPermalink"
    "SpecialTier_chat_postMessage" => "SpecialChatPostMessage"
    "SpecialTier_assistant_threads_setStatus" =>
      "SpecialAssistantThreadsSetStatus"
    other => fail("unknown rate-limit tier in metadata: '\{other}'")
  }
}

///|
/// A MoonBit string literal. Slack's method names are `[A-Za-z.]` today, so
/// this only has to survive that -- but a name that needed escaping would
/// produce a file that does not compile, which is a loud enough failure.
fn escape(s : String) -> String {
  "\"" + s + "\""
}
