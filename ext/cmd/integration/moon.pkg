// The integration harness: the library against a real Slack workspace.
//
// The scenario moved to ext/scenario, so that ext/test/mockrun can run the
// same checks against marianoguerra/slack/mock in CI. What is left here is
// what needs a token: the environment, the real transport, the recording flag
// and the exit code.
//
// Never runs in CI: it needs a token and a workspace.
import {
  "marianoguerra/slack/client",
  "marianoguerra/slack-ext/scenario",
  "marianoguerra/slack-ext/transport_http",
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
}

supported_targets = "+native"

pkgtype(kind: "executable")
