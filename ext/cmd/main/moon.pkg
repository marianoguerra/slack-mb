// A demo CLI whose real job is to exercise @transport, which no unit test
// covers. Needs a real token; never runs in CI.
import {
  "marianoguerra/slack/api",
  "marianoguerra/slack/client",
  "marianoguerra/slack-http/transport",
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "marianoguerra/slack/methods",
}

supported_targets = "+native"

pkgtype(kind: "executable")
